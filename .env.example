# Copie para .env (que o git ignora) e troque os valores. Nunca versione segredos reais.

# --- API (backend) ---
# Desenvolvimento local (docker compose up -d): o Postgres do docker-compose usa usuário e senha `contas`.
# Em produção (Supabase) TROQUE os três valores abaixo pela conexão real: URL JDBC, usuário e senha do projeto.
DATABASE_URL=jdbc:postgresql://localhost:5432/contasclaras
DATABASE_USERNAME=contas
DATABASE_PASSWORD=contas
# Segredo HS256 do cookie de sessão: no mínimo 32 bytes aleatórios (ex.: openssl rand -base64 48).
JWT_SECRET=troque-por-32-bytes-aleatorios-no-minimo
# Client ID OAuth do Google (vazio desliga o login com Google).
GOOGLE_CLIENT_ID=
# Gmail do app e senha de app, para enviar códigos e links (vazio: as rotas de envio respondem 503).
MAIL_USERNAME=
MAIL_PASSWORD=
# Endereço público do front, usado nos links dos e-mails (padrão http://localhost:5173).
APP_URL=http://localhost:5173
# Porta da API (a plataforma define; padrão 8080).
PORT=8080

# --- Front-end ---
VITE_GOOGLE_CLIENT_ID=
